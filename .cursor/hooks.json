{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/check-spaghetti.sh",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false
      },
      {
        "command": ".cursor/hooks/check-security.sh",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/check-spaghetti.sh",
        "failClosed": false
      },
      {
        "command": ".cursor/hooks/check-security.sh",
        "failClosed": false
      }
    ]
  }
}
