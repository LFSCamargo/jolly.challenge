{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "src/routes/index.tsx",
    "src/**/__tests__/**/*.{ts,tsx}",
    "scripts/*.{mjs,sh}"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/*.{mjs,sh}"],
  "ignore": ["dist/**"],
  "ignoreDependencies": [
    "@fontsource-variable/geist",
    "shadcn",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreIssues": {
    "src/components/ui/**": ["exports", "types", "nsExports", "nsTypes"]
  }
}
