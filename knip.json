{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "src/routes/index.tsx",
    "src/**/__tests__/**/*.{ts,tsx}",
    "scripts/*.{mjs,sh}",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "test-fixtures/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/*.{mjs,sh}", "test-fixtures/**/*.ts", "e2e/**/*.ts"],
  "ignore": ["dist/**"],
  "ignoreDependencies": [
    "@fontsource-variable/geist",
    "shadcn",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreIssues": {
    "src/components/ui/**": ["exports", "types", "nsExports", "nsTypes"]
  }
}
